# Recommended: Google Search API through Serper.dev (2,500 free queries)
SERPER_API_KEY=

# Optional: Tavily Search API (1,000 free queries)
TAVILY_API_KEY=

# Optional: increases GitHub API rate limits.
GITHUB_TOKEN=

# Optional: enables structured LLM extraction when OPENAI_MODEL is also set.
LLM_API_KEY=

# Set this with LLM_API_KEY only when enabling a configured LLM research adapter.
OPENAI_MODEL=
